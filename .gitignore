# --- virtualenv ---
.venv/
venv/
env/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- raw data (large, re-downloadable, never committed) ---
# Use a wildcard, not the directory itself: git does not descend into an
# ignored directory, so "data/raw/" would make the negation below unreachable.
data/raw/*
!data/raw/.gitkeep

# --- warehouse (large binary) ---
warehouse/*.duckdb
warehouse/*.duckdb.wal
warehouse/*.wal
# The copy `dwm serve` reads from, so the API can hold a lock without blocking
# the CLI. Rebuilt on demand; never worth committing 424 MB of.
warehouse/dwm.serve.duckdb

# --- generated artefacts ---
# All three are fully regenerable: `dwm mine` writes mining.json, `dwm report`
# writes facts.json and report.md from it. They are ignored together so the
# repository never carries a stale copy of a number the pipeline can rebuild,
# and so a diff never mixes code changes with regenerated results.
reports/*.json
reports/*.md
logs/
*.log
!pip-install.log

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
