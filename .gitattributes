# Normalise line endings so the repo behaves the same on Windows and Linux.
* text=auto eol=lf

*.py   text diff=python
*.md   text
*.yaml text
*.yml  text
*.toml text
*.txt  text

# Batch files are the exception: cmd.exe is unreliable with LF-only line
# endings, particularly `goto` and labels, so they are checked out as CRLF
# whatever the platform. PowerShell is happy either way, so .ps1 stays LF.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary-ish files that must never be rewritten
*.csv  text eol=lf
*.duckdb binary
*.duckdb.wal binary
